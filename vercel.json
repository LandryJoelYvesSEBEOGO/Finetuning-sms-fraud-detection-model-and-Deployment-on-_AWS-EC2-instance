{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "sms_fraud/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,tests/**,docs/**,scripts/**,artifacts/**,.github/**,*.png,*.jpg,requirements-ml.txt,requirements-dev.txt}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/((?!docs$).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
